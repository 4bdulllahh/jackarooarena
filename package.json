{
  "name": "jackarooarena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/three": "^0.187.0",
    "oxlint": "^1.95.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
